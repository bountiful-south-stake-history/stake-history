# Environment Variables for Stake History App
# Copy this file to .env.local and fill in your values

# Supabase Configuration (browser app)
# Get these from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---------------------------------------------------------------------------
# Server-side bulk tooling only (scripts/import-album.ts, run locally via tsx).
# These are NOT read by the Vite app and must NOT carry a VITE_ prefix — a
# VITE_-prefixed var would be bundled into the public browser build.
# The service-role key BYPASSES row-level security: treat it like a password,
# never commit it, and never paste the anon key here (the script refuses any
# key whose role is not 'service_role').
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
